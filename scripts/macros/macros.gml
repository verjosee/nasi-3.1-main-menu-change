/// macros.gml
/// Global Macro Definitions - Game Constants

// ========================
// LEVEL SYSTEM
// ========================
#macro MAX_LEVEL 10                    // Maximum number of levels

// ========================
// LEVEL TIMER CONSTANTS
// ========================
#macro DEFAULT_TIMER 90                // Default level duration in seconds
#macro WAVES_PER_LEVEL 3               // Number of waves per level
#macro WAVE_DURATION 30                // Duration per wave in seconds
#macro SPAWN_RATE_BASE 30              // Base spawn delay in frames
